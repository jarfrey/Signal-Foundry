# Copy this file to .env (same directory) and fill in your key.
# .env is gitignored; .env.example is committed as the template.
#
# Get a key from https://build.nvidia.com/ -> your profile -> API keys.
# Without it the backend still runs, but investor reads fall back to
# deterministic summaries and are labelled "Computed" in the UI.
NEMOTRON_API_KEY=nvapi-your-key-here
